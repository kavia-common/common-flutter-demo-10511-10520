# CocoaPods configuration for Flutter iOS Runner
# This file is required for iOS builds and for native Firebase pods pulled in by Flutter plugins.
#
# Notes:
# - firebase_messaging + firebase_core will bring in Firebase iOS pods via plugin podspecs.
# - flutter_local_notifications requires iOS permission handling at runtime and works with iOS notification frameworks.

platform :ios, '12.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcconfig_path = File.expand_path(File.join('Flutter', 'Generated.xcconfig'), __dir__)
  unless File.exist?(generated_xcconfig_path)
    raise "#{generated_xcconfig_path} must exist. If you're running pod install manually, make sure flutter has generated iOS configs by running:\n  flutter pub get\n  flutter build ios --no-codesign\n"
  end

  File.foreach(generated_xcconfig_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcconfig_path}. Try deleting ios/Flutter/Generated.xcconfig and re-running flutter pub get."
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # If you run into issues with Swift pods + static frameworks, you can uncomment:
  # $FirebaseAsStaticFramework = true
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
